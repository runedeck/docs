build/
dist/
target/
Cargo.lock
.DS_Store

# rune-deployed provider trees and review comments
.claude/
.codex/
.gemini/
.opencode/
.rune-comments.yaml

# Harness integrations written by tool installers. .cursor/BUGBOT.md is
# authored review guidance and stays tracked.
.agent/
.pi/
.cursor/*
!.cursor/BUGBOT.md

# RuneSpec transaction runtime state inside the shared lifecycle tree.
.rune-archive.lock
.rune-transaction/

# Parallel work, one isolated tree per agent: jj workspaces where the repo is
# colocated, git worktrees where it is git-only. Both are ignored before any
# tree exists, because a tree created under a tracked path stays tracked, and
# git follows the nested .jj store that the outer jj skips.
.workspaces/
.worktrees/

# Entire session data (runtime, not source). The hooks Entire installs into
# .githooks/ are tracked source; only its runtime data here is ignored.
.entire/

# SpecStory writes transcripts to the working layer, not the repository.
.specstory/
